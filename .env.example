# Database (PostgreSQL / Neon). Leave empty to use embedded local PGlite in dev/tests.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/back_office

# Security (REQUIRED in staging/production — use at least 32 random bytes)
JWT_SECRET=replace-with-a-cryptographically-secure-64-char-random-secret
JWT_ISSUER=back-office-platform
APP_BASE_URL=http://localhost:3000

# Object Storage (r2 or local)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email Delivery (console or resend)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Back Office <noreply@example.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
